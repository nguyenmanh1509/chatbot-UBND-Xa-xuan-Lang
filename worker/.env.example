# ============================================================
#  Mẫu cấu hình — copy thành .env rồi điền giá trị thật.
#  cp .env.example .env
# ============================================================

# --- Worker production ---
WORKER_URL=https://ubnd-xuanlang-bot.nguyenmanh15092003.workers.dev

# --- Quản trị ---
ADMIN_PASSWORD=

# --- Facebook Messenger ---
# URL gọi lại (Callback URL) điền trong Meta → Messenger → Cài đặt API Messenger
FB_WEBHOOK_URL=https://ubnd-xuanlang-bot.nguyenmanh15092003.workers.dev/webhook/facebook
# Xác minh mã (Verify Token) — phải GIỐNG HỆT ở ô "Xác minh mã" bên Meta
FB_VERIFY_TOKEN=

# Lấy từ Meta for Developers → app → Messenger → Cài đặt API Messenger
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Lấy từ Meta for Developers → app → Cài đặt ứng dụng → Cơ bản → App secret
FB_APP_SECRET=

# --- Zalo Bot Platform (miễn phí) ---
ZB_BOT_TOKEN=
ZB_SECRET_TOKEN=

# --- Zalo OA (cần gói trả phí) ---
ZO_OA_ID=
ZO_APP_ID=
ZO_ACCESS_TOKEN=
ZO_REFRESH_TOKEN=
ZO_SECRET_KEY=

# --- AI ---
GEMINI_API_KEY=
DVC_API_KEY=
